# Core ontology: what every qualitative method shares.
# A method (schema/methods/*.tql) adds concrete subtypes of `code` and `category`
# and its own hierarchy relations. TypeDB checks every rule here at commit time,
# so no harness, prompt or agent can store an analysis that breaks them.
#
# The graph holds the *current* state of one run. History (who changed what, and why)
# is the run's append-only event log; a run is replayed or forked from that log.

define

  # -- attributes ------------------------------------------------------------
  attribute id, value string;
  attribute label, value string;
  attribute description, value string;
  attribute body, value string;                 # memo or source text
  attribute reason, value string;
  attribute actor, value string;                # agent:NAME | human:NAME
  attribute event, value integer;               # event that created or last changed it
  attribute version, value integer;
  attribute start-offset, value integer;
  attribute end-offset, value integer;
  attribute unit, value string;                 # segment id, e.g. P01:s014
  attribute status, value string @values("active", "superseded", "rejected", "proposed");
  attribute memo-kind, value string @values("meaning", "informant", "surprise", "uncertainty",
                                             "method", "negative-case", "summary");
  attribute memo-level, value string @values("interview", "batch", "corpus");
  attribute inclusion, value string;
  attribute exclusion, value string;

  # -- evidence: sources and verified quotes -----------------------------------
  # A quote is a pointer into an immutable source version; the server only creates
  # one after checking the words are in the source. It is never typed in by a model.
  entity source,
    owns id @key, owns label, owns version,
    plays quoting:source, plays about:target, plays assignment:source;

  entity quote,
    owns id @key, owns start-offset, owns end-offset, owns unit, owns body,
    plays quoting:quote @card(1..1),
    plays evidence:quote, plays exemplar:quote;

  # -- interpretation: what the method builds ----------------------------------
  # code: a claim made directly from the data (Gioia: 1st-order concept). Needs a quote.
  entity code @abstract,
    owns id @key, owns label, owns description, owns actor, owns event, owns status,
    plays evidence:claim @card(1..),
    plays about:target, plays supersession:old, plays supersession:new, plays instance:code;

  # category: a claim made from other claims (Gioia: theme, dimension).
  entity category @abstract,
    owns id @key, owns label, owns description, owns actor, owns event, owns status,
    plays about:target, plays supersession:old, plays supersession:new;

  relation quoting, relates source, relates quote;
  relation evidence, relates claim, relates quote, owns reason @card(1..1), owns actor, owns event;
  relation supersession, relates old, relates new, owns reason @card(1..1), owns actor, owns event;

  # -- memory ------------------------------------------------------------------
  # memo: the scholar's notes. Always about something; higher levels cite lower ones.
  entity memo,
    owns id @key, owns memo-kind, owns memo-level, owns body, owns actor, owns event, owns status,
    plays about:memo @card(1..),
    plays citation:citing, plays citation:cited, plays about:target;

  # codebook entry: long-term memory that outlives any context window. Written or
  # approved by a researcher; agents propose (status "proposed").
  entity codebook-entry,
    owns id @key, owns label, owns description, owns inclusion, owns exclusion,
    owns version, owns actor, owns event, owns status,
    plays exemplar:entry, plays instance:entry, plays about:target;

  relation about, relates memo, relates target @card(1..);
  relation citation, relates citing, relates cited;
  relation exemplar, relates entry, relates quote;             # typical / boundary examples
  relation instance, relates entry, relates code, owns reason; # code applied under an entry

  # -- people and agents ---------------------------------------------------------
  # Several scholars can share one analysis: each has its own memos, all share
  # the codebook. Assignment records who read what (overlap = agreement data).
  entity scholar,
    owns id @key, owns label, owns description,
    plays assignment:scholar;
  relation assignment, relates scholar, relates source, owns event;
